# --- База данных ---
POSTGRES_DB=workflow_engine
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_PORT=5434

# --- Приложение ---
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# DATABASE_URL здесь намеренно нет. Адрес БД внутри сети compose задан
# литералом в самом docker-compose.yml, и подстановка переменной перехватывала
# адрес, заданный для хостовых скриптов. Скрипты на хосте (scripts.seed,
# scripts.load, pytest) берут адрес из умолчания app/core/config.py — это
# localhost:5434, то есть опубликованный порт.
CORS_ORIGINS=http://localhost:5173

# --- Движок ---
# TTL lease в секундах: столько воркер может не обновлять heartbeat, прежде чем
# инстанс будет признан брошенным и его сможет перехватить другой воркер.
LEASE_TTL_SECONDS=30
# Период heartbeat во время исполнения шага.
HEARTBEAT_INTERVAL_SECONDS=5
# Число шагов, выполняемых одним воркером до перевыбора задачи.
WORKER_MAX_STEPS_PER_CYCLE=100
# Пауза между циклами опроса очереди задач.
WORKER_POLL_INTERVAL_SECONDS=1
# Максимум попыток исполнения шага перед переходом к компенсации.
STEP_MAX_ATTEMPTS=3
# Интервал SSE-heartbeat, чтобы прокси не рвали соединение.
SSE_HEARTBEAT_SECONDS=15

# Пауза перед повтором отката и потолок паузы в секундах.
# Провал компенсации означает, что внешний сервис недоступен.
COMPENSATION_RETRY_BASE_SECONDS=5
COMPENSATION_RETRY_MAX_SECONDS=300
