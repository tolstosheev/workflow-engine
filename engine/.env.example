# --- Приложение ---
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- База данных ---
# Локально (uvicorn локально) — порт 5433 из docker-compose; внутри compose — db:5432.
DATABASE_URL=postgresql+asyncpg://workflow:workflow@localhost:5433/workflow_engine
# Синхронный драйвер нужен Alembic: asyncpg в синхронном контексте падает.
SYNC_DATABASE_URL=postgresql+psycopg://workflow:workflow@localhost:5433/workflow_engine

CORS_ORIGINS=http://localhost:5173

# --- Движок: lease и координация ---
# TTL lease в секундах: столько воркер может не обновлять heartbeat, прежде чем
# инстанс будет признан брошенным и его сможет перехватить другой воркер.
LEASE_TTL_SECONDS=30
# Период heartbeat во время исполнения шага.
HEARTBEAT_INTERVAL_SECONDS=5
# Число шагов, выполняемых одним воркером до перевыбора задачи.
WORKER_MAX_STEPS_PER_CYCLE=100
# Пауза между циклами опроса очереди задач.
WORKER_POLL_INTERVAL_SECONDS=1
# Максимум попыток исполнения шага (включая первую) перед переходом к компенсации.
STEP_MAX_ATTEMPTS=3
# Интервал SSE-heartbeat, чтобы прокси не рвали соединение.
SSE_HEARTBEAT_SECONDS=15

# --- Логи ---
LOG_LEVEL=INFO
LOG_JSON=false
