# --- Приложение ---
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- База данных ---
# Локально (uvicorn локально) — порт 5434 из docker-compose; внутри compose — db:5432.
DATABASE_URL=postgresql+asyncpg://workflow:workflow@localhost:5434/workflow_engine
# Синхронный драйвер нужен Alembic: asyncpg в синхронном контексте падает.
SYNC_DATABASE_URL=postgresql+psycopg://workflow:workflow@localhost:5434/workflow_engine

CORS_ORIGINS=http://localhost:5173

# --- Движок: lease и координация ---
# TTL lease в секундах: столько воркер может не обновлять heartbeat, прежде чем
# инстанс будет признан брошенным и его сможет перехватить другой воркер.
# --- Пул соединений ---------------------------------
# Пул расчитается НА ПРОЦЕСС: compose поднимает API и два
# воркера. При 100 слотах на базу одной из каждых 10 осталься три даты.
# При четырём воркерах уменьшить дефолт, любя сообрать заа.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Не больше TTL аренды: заблоченный воркер теряет аренду в момент,
# когда без своего соединения.
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800

LEASE_TTL_SECONDS=30
# Период heartbeat во время исполнения шага.
HEARTBEAT_INTERVAL_SECONDS=5
# Число шагов, выполняемых одним воркером до перевыбора задачи.
WORKER_MAX_STEPS_PER_CYCLE=100
# Пауза между циклами опроса очереди задач.
WORKER_POLL_INTERVAL_SECONDS=1
# Максимум попыток исполнения шага (включая первую) перед переходом к компенсации.
STEP_MAX_ATTEMPTS=3
# Интервал SSE-heartbeat, чтобы прокси не рвали соединение.
SSE_HEARTBEAT_SECONDS=15

# --- Логи ---
LOG_LEVEL=INFO
LOG_JSON=false
